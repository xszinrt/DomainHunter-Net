<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_secondary"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/tvDomainName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="example.net"/>
                
            <TextView
                android:id="@+id/tvExpiringSoon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ ينتهي قريباً"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="visible"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            
            <TextView
                android:id="@+id/tvExpiryDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:text="ينتهي في: 2026-07-15"/>
                
            <TextView
                android:id="@+id/tvDaysLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="متبقٍ: 45 يوم"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">
            
            <Button
                android:id="@+id/btnOpen"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🌐 فتح"
                android:backgroundTint="@color/bg_card"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>
                
            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="📋 نسخ"
                android:backgroundTint="@color/bg_card"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:layout_marginEnd="4dp"/>
                
            <Button
                android:id="@+id/btnGoogle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🔍 جوجل"
                android:backgroundTint="@color/bg_card"
                android:textColor="@color/white"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
